<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:paddingTop="0dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:id="@+id/item_image_container"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/cart_product_image"
        app:layout_constraintBottom_toTopOf="@id/item_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="12dp"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
        android:textSize="26sp"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toStartOf="@id/item_price"
        app:layout_constraintStart_toEndOf="@id/item_image_container"
        app:layout_constraintTop_toTopOf="@id/item_image_container"
        tools:text="List item 1" />

    <TextView
        android:id="@+id/item_category"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/cart_item_category"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="@id/item_title"
        app:layout_constraintStart_toStartOf="@id/item_title"
        app:layout_constraintTop_toBottomOf="@id/item_title" />

    <TextView
        android:id="@+id/item_supporting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/cart_item_supporting"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="@id/item_title"
        app:layout_constraintStart_toStartOf="@id/item_title"
        app:layout_constraintTop_toBottomOf="@id/item_category" />

    <TextView
        android:id="@+id/item_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cart_item_price"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
        android:textSize="26sp"
        android:textColor="?attr/colorSecondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/item_image_container" />

    <View
        android:id="@+id/item_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/md_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
