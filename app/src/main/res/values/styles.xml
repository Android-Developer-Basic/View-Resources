<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="OutlinedButton.BaseBarButton" parent="Widget.Material3Expressive.Button">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="cornerRadius">0dp</item>
        <item name="iconTint">?attr/defaultColor</item>
        <item name="backgroundTint">@color/md_theme_background</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
    </style>

    <style name="MaterialAlertDialog.App" parent="MaterialAlertDialog.Material3" />

    <style name="MaterialAlertDialog.App.Title.Text" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_height">64dp</item>
    </style>

    <style name="TextButton.App.ResetPassword" parent="Widget.Material3.Button.TextButton">
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>

    <style name="OutlinedButton.BaseBarButton.BarButton" />

