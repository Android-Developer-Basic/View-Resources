<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="largeRobotoNonBoldTertiary" parent="Widget.Material3.CheckedTextView">
        <item name="android:textColor">@color/dark_tertiary</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="midRobotoNonBoldTertiary" parent="Widget.Material3.CheckedTextView">
        <item name="android:textColor">@color/dark_tertiary</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="mediumRobotoBold" parent="Widget.Material3.CheckedTextView">
        <item name="android:textColor">@color/on_surface_light</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="mediumRobotoNonBold" parent="Widget.Material3.CheckedTextView">
        <item name="android:textColor">@color/on_surface_light</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="smallRobotoNonBold" parent="Widget.Material3.CheckedTextView">
        <item name="android:textColor">@color/on_surface_light</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="largeRobotoNonBold" parent="Widget.Material3.CheckedTextView">
        <item name="android:textColor">@color/on_surface_light</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="resetButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="ctaButton" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <style name="loginButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="cancelButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/secondary</item>
    </style>

</resources>